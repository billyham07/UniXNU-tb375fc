diff --git a/bsd/kern/subr_log.c b/bsd/kern/subr_log.c
--- a/bsd/kern/subr_log.c
+++ b/bsd/kern/subr_log.c
@@ -79,6 +79,7 @@
 #include <os/log_private.h>
 #include <sys/ioctl.h>
 #include <sys/msgbuf.h>
+#include <kern/boot_progress.h>
 #include <sys/file_internal.h>
 #include <sys/errno.h>
 #include <sys/select.h>
@@ -555,6 +556,11 @@ log_putc_locked(struct msgbuf *mbp, char c)
 	if (mbp->msg_bufx >= mbp->msg_size) {
 		mbp->msg_bufx = 0;
 	}
+	/* TB375FC: printf/IOLog still reach msgbuf when the console is muted.
+	 * Copy at the producer (RAM only); never take another BSD log lock. */
+	if (mbp == msgbufp) {
+		boot_progress_msgbuf(c);
+	}
 }
 
