diff --git a/osfmk/console/serial_console.c b/osfmk/console/serial_console.c
index 3a49734..76a69dd 100644
--- a/osfmk/console/serial_console.c
+++ b/osfmk/console/serial_console.c
@@ -253,6 +253,7 @@ static inline void
 _cnputc(char c, bool poll)
 {
 	if (boot_progress_active()) { boot_progress_putc(c); return; }
+	if (c != '\r') { boot_progress_tap(c); }
 	bool in_debugger = (kernel_debugger_entry_count > 0);
 	const uint32_t idx = get_cons_ops_index();
 
diff --git a/osfmk/kern/boot_progress.h b/osfmk/kern/boot_progress.h
index 92f70b4..e713f4a 100644
--- a/osfmk/kern/boot_progress.h
+++ b/osfmk/kern/boot_progress.h
@@ -16,7 +16,39 @@ void boot_progress_user_abort(void *, unsigned, uint64_t);
 void boot_progress_critical_exit(int, char *, unsigned long);
 void boot_progress_process_stage(int, const char *, const char *);
 void boot_progress_exit(int, const char *, int, unsigned, uint64_t);
+#define boot_progress_tap(c) ((void)0)
+#define boot_progress_panic(phase) ((void)0)
+#elif DEVELOPMENT
+/*
+ * TB375FC: the same hook points feed the mrdump recorder (UniXNU-tb375fc package/Tb375fcDiag.c,
+ * glue in package/Tb375fcDiagGlue.c). The console is never taken over: active() stays 0 and
+ * boot_progress_tap() only copies each console character.
+ */
+void tb375fc_glue_init(void);
+void tb375fc_glue_start(void);
+void tb375fc_glue_stage(const char *);
+void tb375fc_glue_putc(char);
+void tb375fc_glue_process(int, const char *, const char *);
+void tb375fc_glue_exit(int, const char *, int, unsigned, uint64_t);
+void tb375fc_glue_panic(int);
+#define boot_progress_init() tb375fc_glue_init()
+#define boot_progress_start() tb375fc_glue_start()
+#define boot_progress_active() 0
+#define boot_progress_bind(...) ((void)0)
+static inline void boot_progress_putc(char c) { (void)c; }
+#define boot_progress_stage(s) tb375fc_glue_stage(s)
+#define boot_progress_irq(...) ((void)0)
+#define boot_progress_poll() ((void)0)
+#define boot_progress_user_breakpoint(...) ((void)0)
+#define boot_progress_user_abort(...) ((void)0)
+#define boot_progress_critical_exit(...) ((void)0)
+#define boot_progress_process_stage(pid, name, s) tb375fc_glue_process((pid), (name), (s))
+#define boot_progress_exit(pid, name, rv, ns, code) tb375fc_glue_exit((pid), (name), (rv), (unsigned)(ns), (uint64_t)(code))
+#define boot_progress_tap(c) tb375fc_glue_putc(c)
+#define boot_progress_panic(phase) tb375fc_glue_panic(phase)
 #else
+#define boot_progress_tap(c) ((void)0)
+#define boot_progress_panic(phase) ((void)0)
 #define boot_progress_init() ((void)0)
 #define boot_progress_start() ((void)0)
 #define boot_progress_active() 0
diff --git a/osfmk/kern/debug.c b/osfmk/kern/debug.c
index c3b6ac2..d6f78c0 100644
--- a/osfmk/kern/debug.c
+++ b/osfmk/kern/debug.c
@@ -1,3 +1,4 @@
+#include <kern/boot_progress.h>
 /*
  * Copyright (c) 2000-2020 Apple Inc. All rights reserved.
  *
@@ -1370,6 +1371,7 @@ panic_trap_to_debugger(const char *panic_format_str, va_list *panic_args, unsign
 void __attribute__((noinline, optnone))
 panic_spin_forever(void)
 {
+	boot_progress_panic(2);
 	for (;;) {
 #if defined(__arm__) || defined(__arm64__)
 		/* On arm32, which doesn't have a WFE timeout, this may not return.  But that should be OK on this path. */
@@ -1542,6 +1544,7 @@ debugger_collect_diagnostics(unsigned int exception, unsigned int code, unsigned
 			PEHaltRestart(kPEPanicDiagnosticsDone);
 			PEHaltRestart(kPEPanicRestartCPUNoCallouts);
 		}
+		boot_progress_panic(1);
 	}
 
 #if CONFIG_KDP_INTERACTIVE_DEBUGGING
