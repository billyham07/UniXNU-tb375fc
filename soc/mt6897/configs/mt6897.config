# Shared kernel configuration of the MT6897 (Dimensity 8300 family).
# CONFIG_XNU_<NAME> becomes XNU_<NAME> in the kernel build. Same bootstrap gates as MT6835.
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
# Architected timer at 13 MHz, PPIs 13/14/11/10 (device FDT).
CONFIG_XNU_NATIVE_ARCH_TIMER=y
CONFIG_XNU_NATIVE_PAN=y
